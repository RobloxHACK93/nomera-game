  ['Ярославская область', ['76']],
  ['Москва', ['77','97','99','177','197','199','777','797','799']],
  ['Санкт-Петербург', ['78','98','178','198']],
  ['Еврейская автономная область', ['79']],
  ['Донецкая Народная Республика', ['80']],
  ['Луганская Народная Республика', ['81']],
  ['Республика Крым', ['82']],
  ['Ненецкий автономный округ', ['83']],
  ['Херсонская область', ['84','184']],
  ['Запорожская область', ['85','185']],
  ['Ханты-Мансийский АО — Югра', ['86','186']],
  ['Чукотский автономный округ', ['87']],
  ['Ямало-Ненецкий автономный округ', ['89']],
  ['Севастополь', ['92']],
  ['Байконур', ['94']]
].sort((a, b) => parseInt(a[1][0], 10) - parseInt(b[1][0], 10));

const TIERS = [
  /* диапазоны по рынку красивых номеров: от минимального тарифа 5 тыс. ₽ до сотен миллионов у самых громких знаков */
  { id: 'common',    name: 'Обычный',     min: 5000,     max: 65000,     p0: 0,  p1: 9,   k: 1,   round: 500 },
  { id: 'rare',      name: 'Редкий',      min: 65000,    max: 400000,    p0: 10, p1: 24,  k: 1.8, round: 5000 },
  { id: 'epic',      name: 'Эпический',   min: 400000,   max: 6000000,   p0: 25, p1: 59,  k: 2.2, round: 50000 },
  { id: 'legendary', name: 'Легендарный', min: 6000000,  max: 60000000,  p0: 60, p1: 100, k: 3.5, round: 500000 }
];

const REGION_BONUS = {
  '77': 6, '97': 5, '99': 5, '177': 8, '197': 8, '199': 8, '777': 16, '797': 8, '799': 8,
  '78': 4, '98': 3, '178': 4, '198': 3,
  '50': 3, '90': 3, '150': 3, '190': 3, '750': 5, '790': 5,
  '116': 2, '716': 3, '102': 2, '702': 3, '161': 2, '761': 3, '163': 2, '763': 3, '774': 3, '196': 2, '186': 2
};

function tierByPoints(p) {
  for (let i = TIERS.length - 1; i >= 0; i--) if (p >= TIERS[i].p0) return TIERS[i];
  return TIERS[0];
}
function hash01(s) {
  let h = 2166136261;
  for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); }
  return ((h >>> 0) % 10000) / 10000;
}
function plateText(p) { return p.l1 + p.d.join('') + p.l2 + p.l3; }
function parsePlate(s, code) {
  return { l1: s[0], d: [+s[1], +s[2], +s[3]], l2: s[4], l3: s[5], code: code };
}

/* очки красоты номера: чем больше, тем дороже */
function evaluate(p) {
  const a = p.d[0], b = p.d[1], c = p.d[2];
  let pts = 0;
  const triple = a === b && b === c && a !== 0;
  if (triple) pts += ({ 7: 48, 8: 40, 9: 40, 6: 30 })[a] || 28;
  else {
    if (a === 0 && b === 0 && c > 0) pts += c === 7 ? 46 : c === 1 ? 38 : 30;      // 00X, 007
    else if (b === 0 && c === 0 && a > 0) pts += a === 7 ? 22 : 18;                // X00
    else if (b === a + 1 && c === b + 1) pts += a === 1 ? 22 : 16;                 // 123, 234 ...
    else if (b === a - 1 && c === b - 1) pts += c === 1 ? 18 : 12;                 // 321, 987 ...
    else if (a === c && a !== b) pts += 8;                                         // 121
    else if (a === b || b === c) pts += 3;                                         // 112, 133
    const sevens = (a === 7) + (b === 7) + (c === 7);
    pts += Math.min(2, sevens);
  }
  const l1 = p.l1, l2 = p.l2, l3 = p.l3;
  const tripleLetters = l1 === l2 && l2 === l3;
  if (tripleLetters) pts += 24;
  else {
    if (l2 === l3) pts += 6;
    else if (l1 === l2 || l1 === l3) pts += 2;
  }
  if (l1 === 'Е' && l2 === 'К' && l3 === 'Х') pts += 18;
  if (triple && tripleLetters) pts += 8;
  let rb = REGION_BONUS[p.code];
  if (rb === undefined) rb = (p.code.length >= 2 && /^(\d)\1+$/.test(p.code)) ? 4 : 0;
  pts += rb;
  if (triple && new RegExp('^' + a + '+$').test(p.code)) pts += 10;
  return Math.min(100, pts);
}
/* за что номер ценится: те же правила, что в evaluate, но с описанием */
function explain(p) {
  const a = p.d[0], b = p.d[1], c = p.d[2], out = [];
  const add = (t, n) => { if (n > 0) out.push({ t: t, n: n }); };
  const triple = a === b && b === c && a !== 0;
  const digits = '' + a + b + c;
  if (triple) add('Три одинаковые цифры ' + digits, ({ 7: 48, 8: 40, 9: 40, 6: 30 })[a] || 28);
  else {
    if (a === 0 && b === 0 && c > 0) add(c === 7 ? 'Номер «007» — как у Джеймса Бонда' : 'Два нуля впереди: ' + digits, c === 7 ? 46 : c === 1 ? 38 : 30);
    else if (b === 0 && c === 0 && a > 0) add('Круглая «сотка» ' + digits, a === 7 ? 22 : 18);
    else if (b === a + 1 && c === b + 1) add('Цифры по порядку ' + digits, a === 1 ? 22 : 16);
    else if (b === a - 1 && c === b - 1) add('Цифры по убыванию ' + digits, c === 1 ? 18 : 12);
    else if (a === c && a !== b) add('Зеркальные цифры ' + digits, 8);
    else if (a === b || b === c) add('Пара одинаковых цифр в ' + digits, 3);
    const sevens = (a === 7) + (b === 7) + (c === 7);
    add(sevens === 1 ? 'Счастливая семёрка' : 'Несколько семёрок', Math.min(2, sevens));
  }
  const tripleLetters = p.l1 === p.l2 && p.l2 === p.l3;
  if (tripleLetters) add('Три одинаковые буквы ' + p.l1 + p.l2 + p.l3, 24);
  else if (p.l2 === p.l3) add('Пара одинаковых букв ' + p.l2 + p.l3, 6);
  else if (p.l1 === p.l2 || p.l1 === p.l3) add('Повтор буквы ' + p.l1, 2);
  if (p.l1 === 'Е' && p.l2 === 'К' && p.l3 === 'Х') add('Легендарные буквы ЕКХ', 18);
  if (triple && tripleLetters) add('Цифры и буквы — одинаковые тройки', 8);
  let rb = REGION_BONUS[p.code];
  if (rb === undefined) rb = (p.code.length >= 2 && /^(\d)\1+$/.test(p.code)) ? 4 : 0;
  add('Престижный регион ' + p.code, rb);
  if (triple && new RegExp('^' + a + '+$').test(p.code)) add('Цифры совпадают с регионом ' + p.code, 10);
  return out;
}
function priceOf(p) {
  const pts = evaluate(p);
  const tier = tierByPoints(pts);
  const h = hash01(plateText(p) + p.code);
  let x = (pts - tier.p0 + h) / (tier.p1 - tier.p0 + 1);
  x = Math.max(0, Math.min(1, x));
  let price = tier.min + (tier.max - tier.min) * Math.pow(x, tier.k);
  price = Math.round(price / tier.round) * tier.round;
  price = Math.max(tier.min, Math.min(tier.max, price));
  return { pts: pts, tier: tier, price: price };
}

/* ===== генерация ===== */
function rnd(n) { return Math.floor(Math.random() * n); }
function pick(a) { return a[rnd(a.length)]; }
function randomPlate(codes) {
  let d;
  do { d = [rnd(10), rnd(10), rnd(10)]; } while (d[0] === 0 && d[1] === 0 && d[2] === 0);
  return { l1: pick(LETTERS), d: d, l2: pick(LETTERS), l3: pick(LETTERS), code: pick(codes) };
}
const MODS = {
  triple: p => { const x = 1 + rnd(9); p.d = [x, x, x]; },
  seven:  p => { p.d = [7, 7, 7]; },
  bond:   p => { p.d = [0, 0, 7]; },
  zz:     p => { p.d = [0, 0, 1 + rnd(9)]; },
  hundred: p => { p.d = [1 + rnd(9), 0, 0]; },
  asc:    p => { const s = 1 + rnd(7); p.d = [s, s + 1, s + 2]; },
  desc:   p => { const s = 3 + rnd(7); p.d = [s, s - 1, s - 2]; },
  pal:    p => { const a = rnd(10); let b = rnd(10); if (b === a) b = (b + 1) % 10; p.d = [a, b, a]; },
  pairD:  p => { const a = rnd(10); p.d = [a, a, (a + 1 + rnd(9)) % 10]; },
  triL:   p => { const l = pick(LETTERS); p.l1 = p.l2 = p.l3 = l; },
  pairL:  p => { p.l3 = p.l2; },
  ekh:    p => { p.l1 = 'Е'; p.l2 = 'К'; p.l3 = 'Х'; }
};
const POOLS = {
  rare: [['hundred'], ['asc'], ['desc'], ['pal', 'pairL'], ['pairD', 'pairL'], ['pairL', 'asc'], ['hundred', 'pairL'], ['pal', 'ekh']],
  epic: [['triple'], ['zz'], ['desc', 'ekh'], ['asc', 'ekh'], ['pal', 'triL'], ['triple', 'pairL'], ['hundred', 'triL'], ['asc', 'triL']],
  legendary: [['seven', 'triL'], ['triple', 'triL'], ['seven', 'ekh'], ['bond', 'ekh'], ['bond', 'triL'], ['seven', 'triL', 'ekh']]
};
function rollTier() {
  const r = Math.random() * 100;
  return r < 62 ? 'common' : r < 84 ? 'rare' : r < 96 ? 'epic' : 'legendary';
}
function generate(codes, forcedTier) {
  const want = forcedTier || rollTier();
  let best = null;
  for (let i = 0; i < 400; i++) {
    const p = randomPlate(codes);
    if (want === 'common') {
      if (Math.random() < .12) p.d[rnd(3)] = 7;
    } else {
      pick(POOLS[want]).forEach(m => MODS[m](p));
    }
    const r = priceOf(p);
    best = { plate: p, pts: r.pts, tier: r.tier, price: r.price };
    if (r.tier.id === want) return best;
  }
  return best;
}
</script>

<script>
(function () {
  const $ = s => document.querySelector(s);
  const fmt = n => n.toLocaleString('ru-RU');
  /* буквы и цифры знака нарисованы как на номерах РФ (символы в начале страницы) */
  const GK = { 'А': 'A', 'В': 'B', 'Е': 'E', 'К': 'K', 'М': 'M', 'Н': 'H', 'О': 'O', 'Р': 'P', 'С': 'C', 'Т': 'T', 'У': 'Y', 'Х': 'X' };
  function glyph(ch) {
    return '<svg class="gl" viewBox="0 0 70 100" aria-hidden="true"><use href="#g-' + (GK[ch] || ('d' + ch)) + '"/></svg>';
  }
  function symHTML(str) { return '<span class="sym">' + String(str).split('').map(glyph).join('') + '</span>'; }

  /* ---------- разметка номера ---------- */
  function plateHTML(p) {
    const s = [p.l1, p.d[0], p.d[1], p.d[2], p.l2, p.l3];
    const reels = s.map(c => '<span class="reel"><span class="strip">' + symHTML(c) + '</span></span>').join('');
    return '<div class="plate"><div class="plate-main">' + reels + '</div>' +
      '<div class="plate-region"><span class="region-code"><span class="reel rreel"><span class="strip">' + symHTML(p.code) + '</span></span></span>' +
      '<span class="rus">RUS<i class="flag"></i></span></div></div>';
  }
  function showItem(s, code) {
    const p = parsePlate(s, code), r = priceOf(p);
    return '<div class="show" data-rarity="' + r.tier.id + '">' + plateHTML(p) +
      '<div class="cap"><span>' + r.tier.name + '</span><b>' + fmt(r.price) + ' ₽</b></div></div>';
  }

  /* ---------- витрина ---------- */
  const SHOW_L = [['Е777КХ','77'],['А001АА','199'],['М007МР','77'],['О777ОО','777'],['Х999ХХ','50'],['В888ВВ','99'],['А123ВС','178'],['Т100ТТ','78']];
  const SHOW_R = [['С777СС','199'],['К555КК','197'],['А005АА','777'],['Е321КХ','97'],['Н777НН','116'],['М666ММ','716'],['Р101РР','161'],['У234УУ','163']];
  const dup = list => list.concat(list).map(x => showItem(x[0], x[1])).join('');
  $('#trackL').innerHTML = dup(SHOW_L);
  $('#trackR').innerHTML = dup(SHOW_R);
  $('#menuPlates').innerHTML = [['Е777КХ','77'],['А001АА','199'],['О777ОО','777']].map(x => showItem(x[0], x[1])).join('');

  /* ---------- редкости ---------- */
  $('#tiers').innerHTML = TIERS.map(t =>
    '<li class="t-' + t.id + '" data-id="' + t.id + '"><strong>' + t.name + '</strong><span>' + fmt(t.min) + ' – ' + fmt(t.max) + ' ₽</span></li>'
  ).join('');

  /* ---------- регионы ---------- */
  const regionSel = $('#region');
  const ALL_CODES = Array.from(new Set(REGIONS.map(r => r[1]).flat()));
  regionSel.innerHTML = '<option value="all">Все регионы · случайный код</option>' +
    REGIONS.map((r, i) => '<option value="' + i + '">' + r[1][0] + ' · ' + r[0] + '</option>').join('');
  let startVal = String(REGIONS.findIndex(r => r[0] === 'Москва'));
  try {
    const raw = localStorage.getItem('nomera-region');
    const saved = parseInt(raw, 10);
    if (raw === 'all') startVal = 'all';
    else if (saved >= 0 && saved < REGIONS.length) startVal = String(saved);
  } catch (e) {}
  regionSel.value = startVal;
  function regionInfo() { return regionSel.value === 'all' ? ['Все регионы', ALL_CODES] : REGIONS[+regionSel.value]; }
  function idleCode() { return regionSel.value === 'all' ? '77' : REGIONS[+regionSel.value][1][0]; }

  /* ---------- центральный номер ---------- */
  const plateWrap = $('#plateWrap');
  let current = ['А', '1', '2', '3', 'В', 'С'];
  plateWrap.innerHTML = plateHTML({ l1: 'А', d: [1, 2, 3], l2: 'В', l3: 'С', code: idleCode() });
  const reelEls = Array.from(plateWrap.querySelectorAll('.plate-main .reel'));
  /* фиксация: понравившиеся буквы и цифры можно оставить, тогда они не крутятся */
  const held = [false, false, false, false, false, false];
  let hasResult = false, regionLocked = false;
  const holdHint = $('#holdHint');
  function updateHold() {
    const n = held.filter(Boolean).length;
    plateWrap.classList.toggle('holdable', hasResult && !spinning);
    holdHint.hidden = !hasResult;
    regionSel.disabled = spinning || regionLocked;   /* после прокрутки с оставленными символами регион заперт, пока номер не продан или не убран в сейф */
    holdHint.textContent = (n
      ? 'Оставлено символов: ' + n + ' (по ' + fmt(HOLD_COST) + ' ₽ за каждый). Они не крутятся, остальные получат новые значения.'
      : 'Нажми на букву или цифру номера, чтобы оставить её на следующую прокрутку: ' + fmt(HOLD_COST) + ' ₽ за каждый символ.')
      + (regionLocked ? ' Регион менять нельзя, пока не продашь номер или не положишь в сейф.' : '');
  }
  function toggleHold(i) {
    if (spinning || !hasResult) return;
    if (!held[i] && held.filter(Boolean).length >= 5) { holdHint.textContent = 'Хотя бы один символ должен крутиться.'; return; }
    if (!held[i] && balance < SPIN_COST + HOLD_COST * (held.filter(Boolean).length + 1)) {
      holdHint.textContent = 'Не хватает денег: оставить символ стоит ' + fmt(HOLD_COST) + ' ₽ сверху к цене броска.';
      return;
    }
    held[i] = !held[i];
    reelEls[i].classList.toggle('held', held[i]);
    reelEls[i].setAttribute('aria-pressed', String(held[i]));
    updateHold(); refreshSpin();
  }
  function clearHolds() {
    held.fill(false); hasResult = false; regionLocked = false;
    reelEls.forEach(el => { el.classList.remove('held'); el.setAttribute('aria-pressed', 'false'); });
    updateHold();
  }
  reelEls.forEach((el, i) => {
    el.setAttribute('role', 'button'); el.tabIndex = 0; el.setAttribute('aria-pressed', 'false');
    el.addEventListener('click', () => toggleHold(i));
    el.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleHold(i); } });
  });
  const regionBox = plateWrap.querySelector('.plate-region');
  const regionReel = plateWrap.querySelector('.rreel');
  let currentCode = idleCode();
  function setRegionCode(c) {
    currentCode = c;
    const s = regionReel.querySelector('.strip');
    s.style.transform = 'none'; s.style.filter = 'none';
    s.innerHTML = symHTML(c);
  }
  const KINDS = ['L', 'D', 'D', 'D', 'L', 'L'];

  /* после продажи или сейфа на знаке остаётся одна рамка: символы плавно гаснут и стираются */
  let blank = false, wipeTimer = 0;
  function finishWipe() {
    if (!wipeTimer) return;
    clearTimeout(wipeTimer); wipeTimer = 0;
    plateWrap.classList.remove('wiping');
    current = ['', '', '', '', '', ''];
    reelEls.forEach(el => { const st = el.querySelector('.strip'); st.style.transform = 'none'; st.style.filter = 'none'; st.innerHTML = symHTML(''); el.classList.remove('land'); });
    setRegionCode('');
  }
  function wipePlate() {
    blank = true;
    clearHolds();
    plateWrap.removeAttribute('data-rarity'); plateWrap.classList.remove('shine');
    if (calm) { wipeTimer = 1; finishWipe(); return; }
    plateWrap.classList.add('wiping');
    clearTimeout(wipeTimer);
    wipeTimer = setTimeout(finishWipe, 320);
  }

  function popRegion() {
    regionBox.classList.remove('pop'); void regionBox.offsetWidth; regionBox.classList.add('pop');
  }
  regionSel.addEventListener('change', () => {
    setRegionCode(blank ? '' : idleCode());
    if (!blank) popRegion();
    try { localStorage.setItem('nomera-region', regionSel.value); } catch (e) {}
  });

  /* ---------- звук барабана ---------- */
  let actx = null, master = null, noiseBuf = null, muted = false;
  function ensureAudio() {
    if (!actx) {
      const AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) return;
      actx = new AC();
      const comp = actx.createDynamicsCompressor();
      master = actx.createGain(); master.gain.value = .8;
      master.connect(comp); comp.connect(actx.destination);
      noiseBuf = actx.createBuffer(1, Math.floor(actx.sampleRate * .25), actx.sampleRate);
      const d = noiseBuf.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
    }
    if (actx.state === 'suspended') actx.resume();
  }
  function noiseHit(t, freq, q, vol, len) {
    const src = actx.createBufferSource(); src.buffer = noiseBuf;
    const bp = actx.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = freq; bp.Q.value = q;
    const g = actx.createGain();
    g.gain.setValueAtTime(vol, t); g.gain.exponentialRampToValueAtTime(.001, t + len);
    src.connect(bp); bp.connect(g); g.connect(master);
    src.start(t, Math.random() * .15); src.stop(t + len + .02);
  }
  function thump(t, f0, f1, vol, len) {
    const o = actx.createOscillator(); o.type = 'sine';
    o.frequency.setValueAtTime(f0, t); o.frequency.exponentialRampToValueAtTime(f1, t + len * .8);
    const g = actx.createGain();
    g.gain.setValueAtTime(vol, t); g.gain.exponentialRampToValueAtTime(.001, t + len);
    o.connect(g); g.connect(master); o.start(t); o.stop(t + len + .02);
  }
  function tickSound() {
    if (muted || !actx) return;
    const t = actx.currentTime;
    noiseHit(t, 1500 + Math.random() * 700, 1.2, .32, .05);
    thump(t, 190, 80, .3, .07);
  }
  function stopSound() {
    if (muted || !actx) return;
    const t = actx.currentTime;
    thump(t, 130, 48, .75, .24);
    noiseHit(t, 900, .9, .35, .08);
  }
  function chime(id) {
    if (muted || !actx) return;
    const seqs = { common: [523], rare: [523, 659], epic: [523, 659, 784], legendary: [523, 659, 784, 1047, 1319, 1568] };
    const t = actx.currentTime + .05;
    seqs[id].forEach((f, i) => {
      const o = actx.createOscillator(); o.type = id === 'legendary' ? 'triangle' : 'sine'; o.frequency.value = f;
      const g = actx.createGain(), st = t + i * .09;
      g.gain.setValueAtTime(.0001, st);
      g.gain.exponentialRampToValueAtTime(.22, st + .02);
      g.gain.exponentialRampToValueAtTime(.0001, st + .8);
      o.connect(g); g.connect(master); o.start(st); o.stop(st + .85);
    });
  }
  const muteBtn = $('#mute');
  muteBtn.addEventListener('click', () => {
    muted = !muted;
    muteBtn.setAttribute('aria-pressed', String(muted));
    muteBtn.setAttribute('aria-label', muted ? 'Включить звук' : 'Выключить звук');
    $('#muteText').textContent = muted ? 'Без звука' : 'Звук';
    $('#muteIcon').innerHTML = muted
      ? '<path d="M11 5L6 9H3v6h3l5 4V5z"/><path d="M22 9l-6 6"/><path d="M16 9l6 6"/>'
      : '<path d="M11 5L6 9H3v6h3l5 4V5z"/><path d="M15.5 8.5a5 5 0 010 7"/><path d="M18.5 5.5a9 9 0 010 13"/>';
  });

  /* ---------- экраны ---------- */
  const menu = $('#menu'), game = $('#game');
  const calm = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
  let switching = false;
  function goGame() {
    if (switching) return;
    switching = true;
    ensureAudio();
    /* игру собираем заранее, невидимой: вёрстка и отрисовка проходят, пока гаснет меню, и сама анимация идёт без рывков */
    game.classList.remove('enter'); game.classList.add('prep');
    game.hidden = false; setTab('game', true);
    menu.classList.add('leaving');
    setTimeout(() => {
      menu.hidden = true; menu.classList.remove('leaving');
      game.classList.remove('prep');
      void game.offsetWidth; game.classList.add('enter');
      window.scrollTo(0, 0);
      switching = false;
    }, calm ? 0 : 560);
  }
  function goMenu() {
    if (switching || spinning) return;
    switching = true;
    game.classList.add('leaving');
    setTimeout(() => {
      game.hidden = true; game.classList.remove('leaving', 'enter');
      menu.hidden = false;
      menu.classList.remove('entering'); void menu.offsetWidth; menu.classList.add('entering');
      window.scrollTo(0, 0);
      switching = false;
    }, calm ? 0 : 350);
  }
  if (!calm) menu.classList.add('entering');
  $('#play').addEventListener('click', goGame);
  $('#back').addEventListener('click', goMenu);

  /* ---------- состояние UI ---------- */
  const whyEl = $('#why');
  const pricePanel = $('#pricePanel'), priceEl = $('#price'), badge = $('#badge');
  const spinBtn = $('#spin'), status = $('#status');
  const tierEls = Array.from(document.querySelectorAll('#tiers li'));
  let spinning = false;

  function countUp(to) {
    const t0 = performance.now(), dur = 1000;
    priceEl.classList.remove('rolling');
    (function step(n) {
      const x = Math.min(1, (n - t0) / dur), e = 1 - Math.pow(1 - x, 3);
      priceEl.textContent = fmt(x < 1 ? Math.round(to * e) : to);
      if (x < 1) requestAnimationFrame(step);
    })(t0);
  }

  /* ---------- баланс и сейф ---------- */
  const START_BALANCE = 500000;
  let balance = START_BALANCE, pending = null;
  const safe = [], trophies = [];
  function loadList(arr, out) {
    (arr || []).forEach(x => {
      const tier = TIERS.find(t => t.id === x.tier);
      if (tier && x.plate && Array.isArray(x.plate.d) && typeof x.price === 'number') out.push({ plate: x.plate, tier: tier, price: x.price });
    });
  }
  try {
    const saved = JSON.parse(localStorage.getItem('nomera-save') || 'null');
    if (saved && typeof saved.balance === 'number' && Array.isArray(saved.safe)) {
      balance = saved.balance;
      loadList(saved.top, trophies);
      saved.safe.forEach(x => {
        const tier = TIERS.find(t => t.id === x.tier);
        if (tier && x.plate && Array.isArray(x.plate.d) && typeof x.price === 'number') safe.push({ plate: x.plate, tier: tier, price: x.price });
      });
    }
  } catch (e) {}
  function persist() {
    try {
      localStorage.setItem('nomera-save', JSON.stringify({
        balance: balance,
        safe: safe.map(h => ({ plate: h.plate, tier: h.tier.id, price: h.price })),
        top: trophies.map(h => ({ plate: h.plate, tier: h.tier.id, price: h.price }))
      }));
    } catch (e) {}
  }
  const wallet = $('#wallet'), actions = $('#actions');
  function updateMenuStats() {
    $('#menuStats').textContent = 'Баланс: ' + fmt(balance) + ' ₽ · В сейфе: ' + safe.length + ' шт.';
  }
  function renderBalance(flash) {
    updateMenuStats();
    $('#balance').textContent = fmt(balance) + ' ₽';
    if (flash) { wallet.classList.remove('up'); void wallet.offsetWidth; wallet.classList.add('up'); }
  }
  function renderHistory() {
    $('#empty').hidden = safe.length > 0;
    $('#safeCount').textContent = safe.length;
    $('#tabCount').textContent = safe.length;
    updateMenuStats();
    $('#hist').innerHTML = safe.map((h, i) =>
      '<li data-rarity="' + h.tier.id + '">' + plateHTML(h.plate) +
      '<div class="meta"><div><small>' + h.tier.name + '</small><span>' + fmt(h.price) + ' ₽</span></div>' +
      '<button class="mini" type="button" data-i="' + i + '">Продать</button></div></li>'
    ).join('');
    $('#total').textContent = fmt(safe.reduce((s, h) => s + h.price, 0)) + ' ₽';
  }
  const SPIN_COST = 80000, HOLD_COST = 50000;
  const heldCount = () => held.filter(Boolean).length;
  const spinCost = () => SPIN_COST + HOLD_COST * heldCount();
  function refreshSpin() {
    if (spinning) return;
    const cost = spinCost(), ok = balance >= cost;
    spinBtn.disabled = !ok;
    spinBtn.textContent = ok ? 'Крутить · ' + fmt(cost) + ' ₽' : 'Не хватает на бросок';
    $('#restart').hidden = !(!pending && balance < SPIN_COST && safe.length === 0);
  }
  function resolvePending() {
    pending = null;
    actions.hidden = true;
    refreshSpin();
  }
  $('#restart').addEventListener('click', () => {
    balance = START_BALANCE;
    renderBalance(true); persist(); refreshSpin();
  });

  /* новая игра из меню */
  const resetAsk = $('#resetAsk'), resetBtn = $('#reset');
  resetBtn.addEventListener('click', () => { resetAsk.hidden = false; resetBtn.hidden = true; });
  $('#resetNo').addEventListener('click', () => { resetAsk.hidden = true; resetBtn.hidden = false; });
  $('#resetYes').addEventListener('click', () => {
    balance = START_BALANCE; safe.length = 0; trophies.length = 0; pending = null; clearHolds();
    actions.hidden = true;
    renderBalance(false); renderHistory(); renderTop(); persist(); refreshSpin();
    resetAsk.hidden = true; resetBtn.hidden = false;
  });
  function addTrophy(x) {
    trophies.push({ plate: x.plate, tier: x.tier, price: x.price });
    trophies.sort((a, b) => b.price - a.price);
    if (trophies.length > 20) trophies.length = 20;
    renderTop();
  }
  $('#sell').addEventListener('click', () => {
    if (!pending) return;
    balance += pending.price;
    addTrophy(pending);
    wipePlate();
    status.textContent = 'Номер продан за ' + fmt(pending.price) + ' рублей';
    resolvePending(); renderBalance(true); persist();
  });
  $('#keep').addEventListener('click', () => {
    if (!pending) return;
    safe.unshift(pending);
    addTrophy(pending);
    wipePlate();
    status.textContent = 'Номер в сейфе';
    resolvePending(); renderHistory(); persist();
    const sb = $('#tabSafe');
    sb.classList.remove('pulse'); void sb.offsetWidth; sb.classList.add('pulse');
  });
  $('#hist').addEventListener('click', e => {
    const btn = e.target.closest('.mini');
    if (!btn) return;
    const i = +btn.dataset.i, item = safe[i];
    if (!item) return;
    safe.splice(i, 1);
    balance += item.price;
    status.textContent = 'Номер продан за ' + fmt(item.price) + ' рублей';
    renderBalance(true); renderHistory(); persist(); refreshSpin();
  });

  /* ---------- вращение ---------- */
  function symsOf(p) { return [p.l1, String(p.d[0]), String(p.d[1]), String(p.d[2]), p.l2, p.l3]; }
  function randSym(kind) { return kind === 'L' ? pick(LETTERS) : String(rnd(10)); }

  function spin() {
    if (spinning || balance < spinCost()) return;
    const cost = spinCost();
    finishWipe(); blank = false;
    if (held.some(Boolean)) regionLocked = true;
    pending = null; actions.hidden = true;   /* непроданный номер можно прокрутить ещё раз: он просто исчезнет */
    balance -= cost;
    renderBalance(false); persist();
    spinning = true;
    ensureAudio();
    const region = regionInfo();
    let res = generate(region[1]);
    if (held.some(Boolean)) {
      const p = res.plate, keep = (i, v) => held[i] ? current[i] : v;
      p.l1 = keep(0, p.l1); p.d = [+keep(1, p.d[0]), +keep(2, p.d[1]), +keep(3, p.d[2])]; p.l2 = keep(4, p.l2); p.l3 = keep(5, p.l3);
      const r = priceOf(p);
      res = { plate: p, pts: r.pts, tier: r.tier, price: r.price };
    }
    const target = symsOf(res.plate);
    updateHold();

    pricePanel.removeAttribute('data-rarity');
    plateWrap.removeAttribute('data-rarity');
    plateWrap.classList.remove('shine');
    tierEls.forEach(li => li.classList.remove('on'));
    badge.textContent = 'Крутим…';
    whyEl.hidden = true;
    priceEl.classList.add('rolling');
    spinBtn.disabled = true; regionSel.disabled = true;
    spinBtn.textContent = 'Крутим…';
    status.textContent = 'Барабан крутится';

    const specs = reelEls.map((el, i) => ({ el: el, cur: current[i], tgt: target[i], pool: () => randSym(KINDS[i]) })).filter((s, i) => !held[i]);
    specs.push({ el: regionReel, cur: currentCode, tgt: res.plate.code, pool: () => pick(region[1]) });
    const reels = specs.map((s, i) => {
      const el = s.el;
      el.classList.remove('land');
      const dur = 2200 + i * 520;
      const n = Math.round(45 * dur / 1000 * 0.6);   // быстрая прокрутка, около 45 символов в секунду
      const items = [s.cur];
      for (let k = 1; k < n; k++) items.push(s.pool());
      items.push(s.tgt);
      const strip = el.querySelector('.strip');
      strip.innerHTML = items.map(c => symHTML(c)).join('');
      strip.style.transform = 'translate3d(0,0,0)';
      return { el: el, strip: strip, n: n, dur: dur, K: n / 0.6, p: 0, done: false, last: s.tgt, h: el.getBoundingClientRect().height };
    });

    const t0 = performance.now();
    let prev = t0, lastTick = 0, lastFlick = 0;

    function frame(now) {
      const dt = Math.max(1, now - prev); prev = now;
      let alive = false, crossings = 0;
      reels.forEach(r => {
        if (r.done) return;
        const x = Math.min(1, (now - t0) / r.dur);
        // первую половину времени барабан летит с постоянной скоростью, потом долго и плавно тормозит
        let p;
        if (x <= 0.4) p = r.K * x;
        else { const y = (x - 0.4) / 0.6; p = r.K * 0.4 + r.K * 0.6 * (1 - Math.pow(1 - y, 3)) / 3; }
        if (x >= 1) p = r.n;
        crossings += Math.floor(p) - Math.floor(r.p);
        const v = (p - r.p) / dt * 1000;
        r.p = p;
        if (x >= 1) {
          r.done = true;
          r.strip.style.filter = 'none';
          r.strip.style.transform = 'none';
          r.strip.innerHTML = symHTML(r.last);
          void r.el.offsetWidth;
          r.el.classList.add('land');
          stopSound();
        } else {
          alive = true;
          r.strip.style.transform = 'translate3d(0,' + (-p * r.h) + 'px,0)';
          r.strip.style.filter = v > 10 ? 'blur(' + Math.min(3.4, (v - 10) / 12).toFixed(2) + 'px)' : 'none';
        }
      });
      if (crossings > 0 && now - lastTick > 34) { tickSound(); lastTick = now; }
      if (now - lastFlick > 70) {
        lastFlick = now;
        const val = Math.exp(Math.log(5000) + Math.random() * (Math.log(60000000) - Math.log(5000)));
        priceEl.textContent = fmt(Math.round(val / 500) * 500);
      }
      if (alive) requestAnimationFrame(frame); else finish();
    }

    function finish() {
      current = target;
      hasResult = true;
      currentCode = res.plate.code;
      popRegion();
      pricePanel.dataset.rarity = res.tier.id;
      plateWrap.dataset.rarity = res.tier.id;
      badge.textContent = res.tier.name;
      tierEls.forEach(li => li.classList.toggle('on', li.dataset.id === res.tier.id));
      const why = explain(res.plate);
      whyEl.innerHTML = '<h3>За что такая цена</h3>' + (why.length
        ? '<ul>' + why.map(w => '<li><span>' + w.t + '</span><b>+' + w.n + '</b></li>').join('') + '</ul>'
        : '<p>Ничем не примечательное сочетание, поэтому цена минимальная.</p>');
      whyEl.hidden = false;
      countUp(res.price);
      chime(res.tier.id);
      if (res.tier.id === 'epic' || res.tier.id === 'legendary') {
        void plateWrap.offsetWidth; plateWrap.classList.add('shine');
      }
      pending = { plate: res.plate, tier: res.tier, price: res.price };
      actions.dataset.rarity = res.tier.id;
      $('#sell').textContent = 'Продать за ' + fmt(res.price) + ' ₽';
      actions.hidden = false;
      status.textContent = plateText(res.plate) + ' ' + res.plate.code + ': ' + res.tier.name + ', ' + fmt(res.price) + ' рублей.';
      spinning = false;
      updateHold();
      refreshSpin();
    }

    requestAnimationFrame(frame);
  }
  spinBtn.addEventListener('click', spin);

  /* вкладки: игра и сейф */
  const stage = document.querySelector('.stage'), safeView = $('#safeView'), topView = $('#topView');
  const tabGame = $('#tabGame'), tabSafe = $('#tabSafe'), tabTop = $('#tabTop');
  function renderTop() {
    $('#topEmpty').hidden = trophies.length > 0;
    $('#topList').innerHTML = trophies.map((x, i) =>
      '<li data-rarity="' + x.tier.id + '"><span class="rank">#' + (i + 1) + '</span>' + plateHTML(x.plate) +
      '<div class="meta"><div><small>' + x.tier.name + '</small></div><b class="price-tag">' + fmt(x.price) + ' ₽</b></div>' +
      '<div class="why"><h3>За что дорогой</h3>' + (function () {
        const w = explain(x.plate);
        return w.length ? '<ul>' + w.map(r => '<li><span>' + r.t + '</span><b>+' + r.n + '</b></li>').join('') + '</ul>'
          : '<p>Ничем не примечательное сочетание, поэтому цена невысокая.</p>';
      })() + '</div></li>'
    ).join('');
  }
  renderTop();
  function setTab(name, quiet) {
    const gameOn = name === 'game';
    stage.hidden = !gameOn; safeView.hidden = name !== 'safe'; topView.hidden = name !== 'top';
    tabGame.setAttribute('aria-selected', String(gameOn));
    tabSafe.setAttribute('aria-selected', String(name === 'safe'));
    tabTop.setAttribute('aria-selected', String(name === 'top'));
    if (gameOn && !quiet) { stage.classList.remove('swap'); void stage.offsetWidth; stage.classList.add('swap'); }
    if (!quiet) window.scrollTo(0, 0);
  }
  tabGame.addEventListener('click', () => setTab('game'));
  tabSafe.addEventListener('click', () => setTab('safe'));
  tabTop.addEventListener('click', () => setTab('top'));

  renderBalance(false);
  renderHistory();
  refreshSpin();
})();
</script>

<script>
if ('serviceWorker' in navigator && location.protocol.startsWith('http')) {
  window.addEventListener('load', function () { navigator.serviceWorker.register('./sw.js').catch(function () {}); });
}
</script>
</body>
</html>
